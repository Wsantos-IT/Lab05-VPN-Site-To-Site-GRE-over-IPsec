! --- Access & Security Basic Config Switch --- !
hostname SWDistr2
no ip domain-lookup
service password-encryption
!
banner motd # 
========================================
 AVISO: Acceso restringido y monitoreado
========================================
 #
banner exec #
 ------------------------------------------------------------
[ ACCESO CONCEDIDO ]
Dispositivo actual: $(hostname)
Entorno: Eve-NG - Lab Win
------------------------------------------------------------
#
!
enable algorithm-type scrypt secret ciscoenpa55
!
! --- Admin User --- !
username admin privilege 15 algorithm-type scrypt secret ciscoadminpa55
!
! --- Remote Access --- !
ip domain-name winlab
ip ssh version 2
crypto key generate rsa general-keys modulus 2048 exportable
!
line vty 0 4
exec-timeout 5 0
logging synchronous
login local
transport input ssh
exit
!
! --- Console ---- !
line con 0
exec-timeout 0 0
logging synchronous
no login
privelege level 15
exit
!
interface loopback 0
ip address 10.255.255.12 255.255.255.255
exit
! --- Network Discovery --- !
lldp run
!
! --- VLAN --- !
!
vlan 1116
name Users
exit
vlan 1132
name RRHH
exit
vlan 99
name GESTION_ADMIN
exit
!
! --- Spanning-Tree --- !
vtp mode transparent
spanning-tree mode rapid-pvst
spanning-tree extend system-id
spanning-tree vlan 1132 root primary
spanning-tree vlan 1116,99 root secondary
!
interface vlan 1116
description USERS_Users
ip address 10.254.16.3 255.255.255.0
standby version 2
standby 16 ip 10.254.16.1
standby 16 priority 100
standby 16 preempt
ip helper-address 10.254.100.100
no shutdown
exit
interface vlan 1132
description USERS_RRHH
ip address 10.254.32.3 255.255.255.0
standby version 2
standby 32 ip 10.254.32.1
standby 32 priority 110
standby 32 preempt
ip helper-address 10.254.100.100
no shutdown
exit
interface vlan 99
description IP_GESTIÓN
ip address 10.254.99.3 255.255.255.0
standby version 2
standby 99 ip 10.254.99.1
standby 99 priority 100
standby 99 preempt
ip helper-address 10.254.100.100
no shutdown
exit
!
! --- Etherchannel --- !
interface range e1/0-1
shut
channel-group 1 mode on
no shut
exit
interface po1
switchport trunk encapsulation dot1q
switchport mode trunk
switchport trunk allowed vlan 99,1116,1132
no shut
!
! --- INTERFACES-TRUNK --- !
interface range e0/2-3
description TRUNK_TO_ACCESS
switchport trunk encapsulation dot1q
switchport mode trunk
switchport trunk native vlan 999
switchport trunk allowed vlan 1116,1132,99
spanning-tree link-type point-to-point
exit
!
! --- Routing --- !
ip Routing
!
interface e0/0
description UPLINK_TO_SWCORE2_G0/2
no switchport
ip address 10.255.255.30 255.255.255.252
exit
interface e0/1
description UPLINK_TO_SWCORE1_G0/3
no switchport
ip address 10.255.255.26 255.255.255.252
exit
!
router ospf 1
network 10.254.16.0 0.0.0.255 area 0
network 10.254.32.0 0.0.0.255 area 0
network 10.254.99.0 0.0.0.255 area 0
network 10.255.255.24 0.0.0.3 area 0
network 10.255.255.28 0.0.0.3 area 0
passive-interface vlan 1116
passive-interface vlan 1132
passive-interface vlan 99
end
!
write
!






