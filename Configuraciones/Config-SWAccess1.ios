! --- Access & Security Basic Config Switch --- !
hostname SWAccess1
no ip domain-lookup
service password-encryption
!
banner motd # 
========================================
 AVISO: Acceso restringido y monitoreado
========================================
 #
banner exec #
 ------------------------------------------------------------
[ ACCESO CONCEDIDO ]
Dispositivo actual: $(hostname)
Entorno: Eve-NG - Lab Win
------------------------------------------------------------
#
!
enable algorithm-type scrypt secret ciscoenpa55
!
! --- Admin User --- !
username admin privilege 15 algorithm-type scrypt secret ciscoadminpa55
!
! --- Remote Access --- !
ip domain-name winlab
ip ssh version 2
crypto key generate rsa general-keys modulus 2048 exportable
!
line vty 0 4
exec-timeout 5 0
logging synchronous
login local
transport input ssh
exit
!
ip default-gateway 10.253.99.1
!
! --- Console ---- !
line con 0
exec-timeout 5 0
logging synchronous
no login
privelege level 15
exit
!
! --- Network Discovery --- !
lldp run
!
! --- VLAN --- !
vlan 99
name GESTIÓN_ADMIN
exit
!
interface vlan 99
description IP_GESTIÓN
ip address 10.253.99.2 255.255.255.0
no shutdown
exit
!
vlan 1116
name Users
exit
vlan 1132
name RRHH
exit
vlan 555
name Black_Hole
exit
!
! --- Spanning-Tree --- !
vtp mode transparent
spanning-tree mode rapid-pvst
spanning-tree extend system-id
spanning-tree vlan 1116,1132,99 priority 61440
!
! --- Interfaces --- !
interface e0/0
description TO_Users_Vlan1116
switchport mode access
switchport access vlan 1116
spanning-tree portfast
spanning-tree bpduguard enable
spanning-tree link-type point-to-point
no cdp enable
no lldp transmit
no lldp receive
!
! --- Admin Interface --- !
interface e0/3
description ADMIN_PC
switchport mode access
switchport access vlan 99
spanning-tree portfast
spanning-tree bpduguard enable
spanning-tree link-type point-to-point
exit
! --- INTERFACES-TRUNK --- !
interface range e0/1-2
description TRUNK_TO_DISTR
switchport trunk encapsulation dot1q
switchport mode trunk
switchport trunk native vlan 999
switchport trunk allowed vlan 1116,1132,99
end
!
write
!
