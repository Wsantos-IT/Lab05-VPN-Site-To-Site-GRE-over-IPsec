! --- Access & Security Basic Config Switch --- !
hostname SWCore2
no ip domain-lookup
service password-encryption
!
banner motd # 
========================================
 AVISO: Acceso restringido y monitoreado
========================================
 #
banner exec #
 ------------------------------------------------------------
[ ACCESO CONCEDIDO ]
Dispositivo actual: $(hostname)
Entorno: Eve-NG - Lab Win
------------------------------------------------------------
#
!
enable algorithm-type scrypt secret ciscoenpa55
!
! --- Admin User --- !
username admin privilege 15 algorithm-type scrypt secret ciscoadminpa55
!
! --- Remote Access --- !
ip domain-name winlab
ip ssh version 2
crypto key generate rsa general-keys modulus 2048 exportable
!
line vty 0 4
exec-timeout 5 0
logging synchronous
login local
transport input ssh
exit
!
! --- Console ---- !
line con 0
exec-timeout 5 0
logging synchronous
no login
privelege level 15
exit
!
interface loopback 0 
ip address 10.255.255.2 255.255.255.255
exit
! --- Network Discovery --- !
lldp run
!
! --- Routing --- !
ip routing
!
! --- UPLINK Edge Interfaces --- !
!
interface e0/0
description TO_SWCORE1
no switchport 
ip address 10.255.255.14 255.255.255.252
no shut
interface e0/1
description TO_EDGE_RTR
no switchport
ip address 10.255.253.5 255.255.255.252
ip ospf 1 area 0
no shut
! --- DOWN LINKS --- !
!
interface e0/2
description DOWNLINK_TO_SWDistr2_G0/0
no switchport
ip address 10.255.255.29 255.255.255.252
exit
interface e0/3
description DOWNLINK_TO_SWDistr1_G0/1
no switchport
ip address 10.255.255.33 255.255.255.252
exit
! --- TO SERVER --- !
interface vlan 100
ip address 10.254.100.1 255.255.255.0
ip ospf 1 area 0
no shut
exit
!
interface e1/0
switchport mode access
switchport access vlan 100
spanning-tree portfast
exit
!
router ospf 1
network 10.255.255.2 0.0.0.0 area 0
network 10.255.255.12 0.0.0.3 area 0
network 10.255.255.28 0.0.0.3 area 0
network 10.255.255.32 0.0.0.3 area 0
end
!
write
!



